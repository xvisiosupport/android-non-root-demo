<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_top"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="250dp"
                android:layout_height="60dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="20dp"
                android:scaleType="centerInside"
                app:srcCompat="@mipmap/logo" />

            <CheckBox
                android:id="@+id/checkbox_save"
                android:text="Save Data"
                android:checked="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/logo"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_time"
                android:text="time: 00:00"
                android:textSize="20dp"
                android:layout_marginLeft="50dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/checkbox_save"
                app:layout_constraintLeft_toRightOf="@+id/checkbox_save"
                />

            <TextView
                android:id="@+id/tv_sdcard"
                android:text="path:"
                android:textSize="20dp"
                android:layout_marginTop="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_save"
                app:layout_constraintLeft_toLeftOf="@+id/checkbox_save"
                />

            <TextView
                android:id="@+id/tv_slam"
                android:text="slam: 0fps"
                android:textSize="20dp"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/logo"
                app:layout_constraintLeft_toLeftOf="@+id/logo"
                />

            <TextView
                android:id="@+id/tv_fisheye"
                android:text="fisheye: 0fps"
                android:textSize="20dp"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/tv_slam"
                app:layout_constraintLeft_toRightOf="@+id/tv_slam"
                />

            <TextView
                android:id="@+id/tv_rgb1"
                android:text="rgb1: 0fps"
                android:textSize="20dp"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/tv_fisheye"
                app:layout_constraintLeft_toRightOf="@+id/tv_fisheye"
                />

            <TextView
                android:id="@+id/tv_rgb2"
                android:text="rgb2: 0fps"
                android:textSize="20dp"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/tv_rgb1"
                app:layout_constraintLeft_toRightOf="@+id/tv_rgb1"
                />

            <TextView
                android:id="@+id/tv_gesture"
                android:text="gesture: 0fps"
                android:textSize="20dp"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/tv_rgb2"
                app:layout_constraintLeft_toRightOf="@+id/tv_rgb2"
                />

            <TextView
                android:id="@+id/tv_pose"
                android:text="pose: "
                android:textSize="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_slam"
                app:layout_constraintLeft_toLeftOf="@+id/tv_slam"
                />

            <TextView
                android:id="@+id/tv_gesture_data"
                android:text="gesture: "
                android:textSize="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_pose"
                app:layout_constraintLeft_toLeftOf="@+id/tv_pose"
                />

            <ImageView
                android:id="@+id/iv_fisheye"
                android:layout_width="640px"
                android:layout_height="480px"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_gesture_data"
                app:layout_constraintLeft_toLeftOf="parent"
                />
            <ImageView
                android:id="@+id/iv_rgb1"
                android:layout_width="640px"
                android:layout_height="480px"
                app:layout_constraintTop_toTopOf="@+id/iv_fisheye"
                app:layout_constraintLeft_toRightOf="@+id/iv_fisheye"
                />

            <ImageView
                android:id="@+id/iv_rgb2"
                android:layout_width="640px"
                android:layout_height="480px"
                app:layout_constraintTop_toTopOf="@+id/iv_fisheye"
                app:layout_constraintLeft_toRightOf="@+id/iv_rgb1"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>